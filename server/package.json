{
    "name": "apollo-server",
    "version": "1.0.0",
    "description": "apollo nodejs services",
    "scripts": {
        "pm2": "pm2-runtime start process.config.js",
        "api:ts": "node --watch --experimental-transform-types src/api.ts",
        "api:dev": "npm run pm2 -- --only \"api:tsx\"",
        "api:prod": "npm run pm2 -- --only \"api\"",
        "workers:dev": "npm run pm2 -- --only \"tsc-compiler, workers\"",
        "workers:prod": "npm run pm2 -- --only \"workers\"",
        "cron:prod": "npm run pm2 -- --only \"cron\"",
        "rm-crawler:dev": "npm run pm2 -- --only \"tsc-compiler, rm-crawler\"",
        "rm-crawler:prod": "npm run pm2 -- --only \"rm-crawler\"",
        "build": "tsc -p tsconfig.build.json",
        "build:clean": "rm -rf dist && npm run build",
        "build:watch": "npm run build -- --watch",
        "knex:migration": "knex migrate:make ${1}",
        "knex:migrate": "knex migrate:latest",
        "test": "jest --forceExit"
    },
    "bin": {
        "run": "./src/cli.ts"
    },
    "author": "simonpiscitelli@gmail.com",
    "license": "ISC",
    "private": true,
    "dependencies": {
        "@ai-sdk/openai": "^2.0.89",
        "@aws-sdk/client-s3": "=3.682.0",
        "@aws-sdk/s3-request-presigner": "=3.682.0",
        "@bahatron/mercurios": "^3.1.4",
        "@bahatron/utils": "^4.1.1",
        "@bull-board/express": "^6.16.2",
        "@clickhouse/client": "^1.16.0",
        "@faker-js/faker": "^10.2.0",
        "@google/genai": "^1.35.0",
        "@mapbox/geojson-rewind": "^0.5.2",
        "@modelcontextprotocol/sdk": "^1.25.2",
        "@turf/turf": "^7.3.1",
        "@types/cheerio": "^0.22.35",
        "@types/compression": "^1.8.1",
        "@types/d3-array": "^3.2.2",
        "@types/fuzzyset": "^1.0.7",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/lodash": "^4.17.23",
        "@types/node": "^24.10.7",
        "@types/node-cron": "^2.0.8",
        "@types/pg": "^8.16.0",
        "@types/proj4": "^2.5.6",
        "@types/qrcode": "^1.5.6",
        "@types/shapefile": "^0.6.4",
        "@types/stream-json": "^1.7.8",
        "@types/unzipper": "^0.10.11",
        "@types/yargs": "^17.0.35",
        "agent-base": "^7.1.4",
        "ai": "^5.0.121",
        "apache-arrow": "^17.0.0",
        "axios": "=1.13.2",
        "bullmq": "^5.66.5",
        "cheerio": "^1.1.2",
        "compression": "^1.8.1",
        "csv": "^6.4.1",
        "d3-array": "^3.2.4",
        "express": "^5.2.1",
        "fast-xml-parser": "^4.5.3",
        "fuzzyset": "^1.0.7",
        "geojson2h3": "^1.2.0",
        "h3-js": "^4.4.0",
        "jsonwebtoken": "^9.0.3",
        "knex": "^2.5.1",
        "lodash": "^4.17.21",
        "moment": "^2.30.1",
        "node-cron": "^3.0.3",
        "openai": "^6.16.0",
        "pg": "^8.16.3",
        "pg-query-stream": "^4.10.3",
        "playwright": "^1.57.0",
        "proj4": "^2.20.2",
        "qrcode": "^1.5.4",
        "recursive-diff": "^1.0.9",
        "redis": "^4.7.1",
        "shapefile": "^0.6.6",
        "socks": "^2.8.7",
        "socks-proxy-agent": "^5.0.1",
        "stream-json": "^1.9.1",
        "tiktoken": "^1.0.22",
        "ts-node": "^10.9.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
